# ── Django ───────────────────────────────────────────────────────────────────
# Local development: DEBUG=True. Production: DEBUG=False and set a real SECRET_KEY.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret

# Comma-separated hosts. VERCEL_URL is added automatically on Vercel.
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# ── Database ─────────────────────────────────────────────────────────────────
# Used when DEBUG=True.
DB_NAME=nvhlearningdb
DB_USER=admindb
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Used when DEBUG=False (production/staging). Takes precedence over the values above.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DB_CONN_MAX_AGE=600
# DB_SSLMODE=require

# Optional path to a CA certificate for PostgreSQL TLS.
# DB_SSLROOTCERT=/path/to/ca.pem

# ── CORS / CSRF ─────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# CSRF_TRUSTED_ORIGINS=https://your-app.example.com
# Defaults to True when DEBUG=False. Set False only when testing locally over HTTP.
# SECURE_SSL_REDIRECT=True

# ── AI provider ─────────────────────────────────────────────────────────────
# openai (default) or gemini
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Gemini (only when AI_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key
# Use a current stable model; gemini-2.0-flash was shut down on 2026-06-01.
# GEMINI_MODEL_NAME=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_CACHE_TTL=21600

# Model names used by specific AI features.
# AI_MODEL_NAME=gpt-4o-mini
# AI_EXTRACTION_MODEL_NAME=gpt-4.1
# AI_TUTOR_MODEL_NAME=gpt-4.1

# RAG limits and caching.
# AI_RAG_MAX_CONTEXT_CHARS=5000
# AI_RAG_MAX_CHUNK_CHARS=650
# AI_RAG_CACHE_TTL_SECONDS=300

# Days between AI class-insight regenerations (0 disables the cooldown).
# AI_INSIGHT_COOLDOWN_DAYS=5

# ── Cloudinary (required for image/document uploads) ────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Cache and rate limiting ─────────────────────────────────────────────────
# locmem (default) or db. Use db after creating the cache table.
CACHE_BACKEND=locmem
# DRF_ANON_THROTTLE_RATE=60/min
# DRF_USER_THROTTLE_RATE=300/min
# DRF_AI_CHAT_THROTTLE_RATE=30/hour
# DRF_AI_GENERATE_THROTTLE_RATE=40/hour

# ── Vercel notification cron ────────────────────────────────────────────────
# Vercel sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-to-a-random-cron-secret
