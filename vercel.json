{
  "version": 2,
  "builds": [
    {
      "src": "static/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "nvh_learning/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "100mb", "runtime": "python3.12" }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "nvh_learning/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/run-due/",
      "schedule": "0 0 * * *"
    }
  ]
}
